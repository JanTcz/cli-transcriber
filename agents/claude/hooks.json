{
  "description": "Blocks edits to files cli-transcriber generated and points to their YAML source.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/claude/guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
